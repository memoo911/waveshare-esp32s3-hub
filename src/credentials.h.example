#pragma once

// Optional. WiFi is normally set up from a phone: Settings -> WiFi -> Add
// network on the device. If you prefer, copy this file to credentials.h and
// list networks here. On boot they are copied once into the board's saved
// networks, where they can be deleted; a deleted one is not copied again.
// credentials.h is gitignored and will not be committed.

#include "Config.h"

// Tried in order; the first one in range is used.
const WiFiNetwork WIFI_NETWORKS[] = {
    {"your-home-ssid", "your-home-password"},
};
constexpr int WIFI_NETWORK_COUNT =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);
