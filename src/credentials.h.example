#pragma once

// Copy this file to credentials.h (same folder) and fill in what you use.
// credentials.h is gitignored and will not be committed.

#include "Config.h"

// --- WiFi (optional) -----------------------------------------------------
// WiFi is normally set up from a phone: Settings -> WiFi -> Add network on
// the device. If you prefer, list networks here. On boot they are copied once
// into the board's saved networks, where they can be deleted; a deleted one
// is not copied again. Empty lines are ignored.
// Tried in order; the first one in range is used.
const WiFiNetwork WIFI_NETWORKS[] = {
    {"", ""}, // e.g. {"MyHomeWiFi", "my-password"}
};
constexpr int WIFI_NETWORK_COUNT =
    sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// --- Assistant (optional) ------------------------------------------------
// Your own Cloudflare Worker from the worker/ folder (see README, "Assistant").
// Leave empty and the Assistant app says it isn't set up.
#define ASSISTANT_URL ""   // e.g. "https://clock-assistant.<your-subdomain>.workers.dev/ask"
#define ASSISTANT_TOKEN "" // the DEVICE_TOKEN you gave the Worker
